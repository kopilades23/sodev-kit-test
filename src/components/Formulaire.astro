---
import entreprise from '../data/entreprise.json';
import technique from '../data/technique.json';
import accueil from '../data/accueil.json';
const cle = technique.web3forms_cle;
const site = technique.url.replace(/\/$/, '');
---
<form class="formulaire bloc" action="https://api.web3forms.com/submit" method="POST" data-formulaire>
  <h3>{accueil.contact?.titre_formulaire || 'Envoyer un message'}</h3>
  {!cle && <p class="alerte">Formulaire inactif : la clé Web3Forms n'est pas encore renseignée (src/data/technique.json).</p>}
  <input type="hidden" name="access_key" value={cle} />
  <input type="hidden" name="subject" value={`Nouveau message depuis le site ${entreprise.nom}`} />
  <input type="hidden" name="from_name" value={`Site ${entreprise.nom}`} />
  <input type="hidden" name="redirect" value={`${site}/merci/`} />
  <input type="checkbox" name="botcheck" class="piege" tabindex="-1" autocomplete="off" aria-hidden="true" />
  <div class="champ">
    <label for="f-nom">Nom</label>
    <input id="f-nom" name="name" type="text" autocomplete="name" required />
  </div>
  <div class="champ-ligne">
    <div class="champ">
      <label for="f-email">E-mail</label>
      <input id="f-email" name="email" type="email" autocomplete="email" required />
    </div>
    <div class="champ">
      <label for="f-tel">Téléphone <span class="facultatif">(facultatif)</span></label>
      <input id="f-tel" name="telephone" type="tel" autocomplete="tel" />
    </div>
  </div>
  <div class="champ">
    <label for="f-message">Message</label>
    <textarea id="f-message" name="message" rows="5" required></textarea>
  </div>
  <p class="petit">Vos informations servent uniquement à répondre à votre demande. <a href="/confidentialite/">En savoir plus</a>.</p>
  <button class="bouton bouton--principal" type="submit" disabled={!cle}>Envoyer</button>
  <p class="formulaire__statut" role="status" aria-live="polite"></p>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-formulaire]').forEach((form) => {
    const statut = form.querySelector<HTMLElement>('.formulaire__statut')!;
    const bouton = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      bouton.disabled = true;
      statut.textContent = 'Envoi en cours…';
      statut.className = 'formulaire__statut';
      try {
        const donnees = Object.fromEntries(new FormData(form));
        delete (donnees as Record<string, unknown>).redirect;
        const rep = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(donnees),
        });
        const json = await rep.json();
        if (!rep.ok || !json.success) throw new Error(json.message);
        form.reset();
        statut.textContent = 'Merci ! Votre message a bien été envoyé. Nous vous répondons rapidement.';
        statut.classList.add('formulaire__statut--ok');
      } catch {
        statut.textContent = "Le message n'a pas pu être envoyé. Appelez-nous directement, ou réessayez dans quelques minutes.";
        statut.classList.add('formulaire__statut--erreur');
      } finally {
        bouton.disabled = false;
      }
    });
  });
</script>
