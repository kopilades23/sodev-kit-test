---
import accueil from '../data/accueil.json';
const s = accueil.atouts;
const liste = (s?.liste ?? []).filter((a) => a?.titre);
---
{s?.afficher && liste.length > 0 && (
  <section class="section section--compacte" id="atouts">
    <div class="conteneur">
      <div class="section__entete">
        {s.surtitre && <p class="surtitre">{s.surtitre}</p>}
        <h2>{s.titre}</h2>
      </div>
      <ul class="atouts">
        {liste.map((a, i) => (
          <li class="atout">
            <span class="atout__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{a.titre}</h3>
            {a.texte && <p>{a.texte}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}
